# Session signing (min 16 chars; required on Vercel)
AUTH_SECRET=change-me-to-a-long-random-string

# Postgres — users + sync job status only
DATABASE_URL=postgresql://localhost:5432/trust-me-bro-forecast

# https://www.kaggle.com/
KAGGLE_API_TOKEN=

# https://newsapi.org/
NEWSAPI_API_KEY=

# Update data: Kaggle → public/btc-price-history.json (ALL rows) → same file on R2
# Chart loads the full JSON. Vercel: HISTORY_JSON_URL → pub-….r2.dev/btc-price-history.json

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=pricepoints
R2_OBJECT_KEY=btc-price-history.json
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com

HISTORY_JSON_URL=https://pub-XXXXXXXX.r2.dev/btc-price-history.json
