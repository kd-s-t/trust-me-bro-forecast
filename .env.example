# Session signing (min 16 chars)
AUTH_SECRET=change-me-to-a-long-random-string

# Optional session lifetime (default 7 days). Renews on activity after 24h.
# SESSION_MAX_AGE_DAYS=7
# SESSION_MAX_AGE_HOURS=168

# Postgres — users, sync jobs, price history, AI forecasts
DATABASE_URL=postgresql://localhost:5432/trust-me-bro-forecast

# Dev only: chart samples fewer history points (default 3000) for faster loads
# CHART_HISTORY_CAP=3000

# https://www.kaggle.com/
KAGGLE_API_TOKEN=

# https://newsapi.org/ — top 3 headlines for each forecast
NEWSAPI_API_KEY=

# https://platform.openai.com/ — required for Assistant Bro; optional for quick Forecast (else news-sentiment)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# https://www.binance.com/en/my/settings/api-management
# Reading: balances. Enable Spot & Margin Trading only when using auto trade below.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=
# Auto trade on market sync (Jun 2 bet in lib/chartBetMarker.ts). Default off.
FEATURE_FLAG_AUTO_SELL=false
FEATURE_FLAG_AUTO_BUY=false
# Chart live tail (public market data; default BTCUSDT)
# BINANCE_MARKET_SYMBOL=BTCUSDT
# Chart: auto Binance → Postgres every N ms (default 15000, on by default)
# NEXT_PUBLIC_BINANCE_TICK_INTERVAL_MS=15000
# NEXT_PUBLIC_BINANCE_TICK_AUTO=false
# Optional — API keys cannot read your Binance login email; set it to show in the sidebar
# BINANCE_ACCOUNT_EMAIL=you@example.com

# Optional — app login email (per user, applied on db:migrate seed)
# USER_KENN_EMAIL=kenn@example.com
# USER_JOHN_EMAIL=john@example.com
